  {
    "id": "func_descifrar",
    "type": "function",
    "z": "t1",
    "name": "Descifrar AES-GCM",
    "func": "// Descifra el potenciometro: Base64( nonce[12] | cifrado | tag[16] ) con AES-128-GCM.\n// Salida 1: valor valido -> gauge y grafica\n// Salida 2: aviso cuando el mensaje fue alterado (no se muestra ningun valor corrupto)\nconst NONCE_LEN = 12;\nconst TAG_LEN = 16;\n\nconst clave = Buffer.from(env.get(\"AES_KEY_HEX\") || \"\", \"hex\");\nif (clave.length !== 16) {\n    node.error(\"Falta AES_KEY_HEX: arranca Node-RED con herramientas/iniciar_nodered.sh\");\n    return null;\n}\n\nconst paquete = Buffer.from(String(msg.payload), \"base64\");\nif (paquete.length <= NONCE_LEN + TAG_LEN) {\n    return rechazar(\"mensaje demasiado corto\");\n}\n\nconst nonce = paquete.subarray(0, NONCE_LEN);\nconst cifrado = paquete.subarray(NONCE_LEN, paquete.length - TAG_LEN);\nconst tag = paquete.subarray(paquete.length - TAG_LEN);\n\ntry {\n    const descifrador = crypto.createDecipheriv(\"aes-128-gcm\", clave, nonce);\n    descifrador.setAuthTag(tag);\n    // final() truena si el tag no cuadra, o sea si alguien cambio aunque sea un bit\n    const texto = Buffer.concat([descifrador.update(cifrado), descifrador.final()]).toString(\"utf8\");\n\n    node.status({ fill: \"green\", shape: \"dot\", text: \"OK: \" + texto + \"%\" });\n    return [{ payload: parseFloat(texto) }, null];\n} catch (e) {\n    return rechazar(\"tag invalido, el mensaje fue alterado\");\n}\n\nfunction rechazar(motivo) {\n    node.status({ fill: \"red\", shape: \"ring\", text: \"RECHAZADO: \" + motivo });\n    node.warn(\"pot/value RECHAZADO (\" + motivo + \"): \" + msg.payload);\n    return [null, { payload: \"RECHAZADO \" + new Date().toLocaleTimeString() + \" - \" + motivo }];\n}",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [
      {
        "var": "crypto",
        "module": "crypto"
      }
    ],
    "x": 300,
    "y": 440,
    "wires": [
      [
        "gauge_pot",
        "chart_pot"
      ],
      [
        "text_seguridad"
      ]
    ]
  },
