  {
    "id": "func_format_status",
    "type": "function",
    "z": "t1",
    "name": "Formatear STATUS legible",
    "func": "let data = msg.payload;\nif (typeof data === \"string\") {\n    try { data = JSON.parse(data); } catch (e) { return msg; }\n}\n\nlet texto = \"Modo: \" + data.mode + \"  |  Color: \" + data.color;\n\nif (data.mode === \"BLINK\" && data.freq !== undefined) {\n    texto += \"  |  Frecuencia: \" + data.freq + \" Hz\";\n}\n\ntexto += \"  |  Tiempo desde el ultimo cambio: \" + data.time + \"s\";\ntexto += \"  |  Potenciometro: \" + data.pot;\n\nmsg.payload = texto;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 280,
    "y": 520,
    "wires": [
      [
        "text_light_status"
      ]
    ]
  },
